#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
TOOLCHAIN_DIR="$ROOT_DIR/runs/local/toolchain/pnpm-10.33.3"
PINNED_BIN="$TOOLCHAIN_DIR/node_modules/.bin/pnpm"

if [[ ! -x "$PINNED_BIN" ]]; then
  mkdir -p "$TOOLCHAIN_DIR"
  npm install --prefix "$TOOLCHAIN_DIR" --no-save --ignore-scripts --no-audit --no-fund pnpm@10.33.3 >/dev/null
fi

exec "$PINNED_BIN" "$@"
